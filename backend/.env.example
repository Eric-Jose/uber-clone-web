# .env.example (Backend)

# MongoDB
MONGODB_URI=mongodb://localhost:27017/uber-clone

# JWT
JWT_SECRET=sua_chave_super_secreta_aqui_12345
JWT_EXPIRE=7d

# Firebase Admin - use the service account values in Railway/Vercel environment settings, never commit real secrets
FIREBASE_PROJECT_ID=seu-projeto-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto-firebase.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nSUA_CHAVE_PRIVADA\\n-----END PRIVATE KEY-----\\n"

# Stripe (Pagamento)
STRIPE_SECRET_KEY=sk_test_sua_chave_secreta_aqui
STRIPE_PUBLIC_KEY=pk_test_sua_chave_publica_aqui

# Email
EMAIL_USER=seu_email@gmail.com
EMAIL_PASSWORD=sua_senha_app_especifica
EMAIL_FROM=noreply@uberclone.com

# Admin
ADMIN_EMAIL=admin@uberclone.com
ADMIN_PASSWORD=SenhaForte123!
ADMIN_2FA_SECRET=seu_secret_2fa_aqui

# Servidor
PORT=5000
NODE_ENV=production

# CORS
CORS_ORIGIN=https://uber-clone-web.vercel.app

# Despacho automático de corridas
DISPATCH_RADIUS_KM=25
DISPATCH_RADIUS_EXTENDED_KM=50
DISPATCH_RADIUS_LONG_KM=100

# Tempo máximo sem atualização para considerar a localização do motorista válida
DRIVER_LOCATION_FRESH_MS=120000
