# Firebase Admin
FIREBASE_PROJECT_ID=seu-projeto-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=seu-service-account@seu-projeto.iam.gserviceaccount.com
FIREBASE_DATABASE_URL=https://seu-projeto-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
FIREBASE_WEB_API_KEY=sua-web-api-key

# Auth / server
JWT_SECRET=gere-uma-chave-longa-e-aleatoria
PORT=5000
NODE_ENV=production

# Optional dispatch tuning
DISPATCH_RADIUS_KM=25
DISPATCH_RADIUS_EXTENDED_KM=50
DISPATCH_RADIUS_LONG_KM=100

# Admin provisioning (configure only in Railway/Vercel environment, never commit real values)
ADMIN_EMAIL=seu-email-admin
ADMIN_PASSWORD=uma-senha-forte
ADMIN_NAME=Administrador
