# =============================================================================
# PreçoFixo17 — Exemplo de variáveis de ambiente
# -----------------------------------------------------------------------------
# Copie este arquivo para .env (backend/local) e/ou configure estas variáveis
# no painel do seu provedor de deploy (ex.: Vercel > Settings > Environment
# Variables). NUNCA faça commit de valores reais — apenas deste arquivo de
# exemplo, sem segredos.
# =============================================================================

# --- Segurança / Autenticação -------------------------------------------------
# Segredo usado para assinar os tokens JWT. OBRIGATÓRIO em produção.
# Gere um valor forte, por exemplo: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE=7d
# Defina como "production" no ambiente de produção.
NODE_ENV=

# --- Conta de administrador ---------------------------------------------------
# Credenciais do admin padrão. OBRIGATÓRIAS em produção (sem elas não há
# admin semente). Use uma senha forte.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
ADMIN_2FA_SECRET=

# --- Firebase Admin SDK (backend) ---------------------------------------------
# Credenciais da service account. A chave privada deve ser colada com os
# "\n" escapados em uma única linha, entre aspas.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=
FIREBASE_WEB_API_KEY=

# --- Firebase Web SDK (frontend, prefixo REACT_APP_) --------------------------
# Estes NÃO são segredos (vão para o navegador), mas configure-os aqui.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=

# --- Frontend / App -----------------------------------------------------------
REACT_APP_BACKEND_URL=
REACT_APP_ENV=
REACT_APP_GOOGLE_MAPS_KEY=
REACT_APP_STRIPE_KEY=

# --- Integrações / Serviços ---------------------------------------------------
CORS_ORIGIN=
EMAIL_FROM=
EMAIL_USER=
EMAIL_PASSWORD=
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=
MONGODB_URI=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# --- Configurações de despacho de corridas ------------------------------------
DISPATCH_RADIUS_KM=
DISPATCH_RADIUS_EXTENDED_KM=
DISPATCH_RADIUS_LONG_KM=
DRIVER_LOCATION_FRESH_MS=
